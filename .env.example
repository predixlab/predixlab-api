# Database
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=predixlab
MARKET_OVERVIEWS_COLLECTION=market_overviews
ALPHARANK_COLLECTION=alpharank
ALPHARANK_GENERATIONS_COLLECTION=alpharank_generations
# Application cleanup also bounds storage when custom-field TTL is unsupported.
EXPIRY_CLEANUP_INTERVAL_SECONDS=3600

# JWT (replace SECRET_KEY before deployment)
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# MongoDB-backed per-IP limits for token endpoints
OAUTH_EXCHANGE_IP_LIMIT=20
OAUTH_EXCHANGE_WINDOW_SECONDS=300
REFRESH_IP_LIMIT=60
REFRESH_WINDOW_SECONDS=300

# OAuth session signing: required, generate independently of SECRET_KEY
# python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# Email: use console locally; switch to acs and configure ACS for production
# Shared with Campaign; empty/unset falls back to SECRET_KEY. New links expire in 365 days.
UNSUBSCRIBE_SECRET=
# Keep old untimed and SECRET_KEY-signed links valid during migration.
UNSUBSCRIBE_ALLOW_LEGACY_TOKENS=True
# Optional ISO date/datetime; dates and timezone-less values use UTC.
# At/after this cutoff, only timed UNSUBSCRIBE_SECRET links are accepted.
# UNSUBSCRIBE_LEGACY_CUTOFF=2027-01-01T00:00:00Z
# EMAIL_BACKEND: "acs" delivers via Azure Communication Services,
# "console" logs the message instead (use this for local development).
EMAIL_BACKEND=console
ACS_CONNECTION_STRING=
ACS_SENDER=

# OAuth (leave unused providers blank)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_CALLBACK_URL="http://localhost:8000/api/v1/auth/google/callback"

MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_OAUTH_CALLBACK_URL="http://localhost:8000/api/v1/auth/microsoft/callback"

# Frontend URL to return to after OAuth completes
OAUTH_REDIRECT_URL="http://localhost:3000/auth/callback"

# Application
APP_NAME="PredixLab"
APP_VERSION=1.0.0
PUBLIC_API_URL="http://localhost:8000"
USER_NOTICE_VERSION=2026-08-09
DEBUG=False
# Optional: True/False overrides DEBUG for /openapi.json, /docs, and /redoc.
# ENABLE_API_DOCS=False
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
FREE_USER_DAYS_LIMIT=10

# Referral program
REFERRAL_PROGRAM_ENABLED=True
REFERRAL_FRONTEND_URL="http://localhost:3000/register"
REFERRAL_CODE_LENGTH=8
REFERRAL_INVITER_REWARD_DAYS=15
REFERRAL_INVITEE_REWARD_DAYS=7
REFERRAL_MAX_REWARDED_REFERRALS=20

# Shared data paths from Collector
# These two directories remain Settings compatibility fields; the service does not read from them.
PREDICTIONS_DIR=data/predictions
PICKS_DIR=data/picks
PREDIXLAB_DATA_DIR=data
US_STOCK_DATA_DIR=data/stock_data/us_data
# Comma-separated, case-insensitive symbols read ONLY from the reference directory.
# Whitespace and empty entries are ignored; all other symbols (including ^GSPC)
# read ONLY from US_STOCK_DATA_DIR. Neither route falls back to the other directory.
US_REFERENCE_SYMBOLS=SPY,QQQ,IWM,DIA
# Optional index history override; otherwise use <PREDIXLAB_DATA_DIR>/reference_data/us_indices,
# or derive the same path from US_STOCK_DATA_DIR's data root when PREDIXLAB_DATA_DIR is unset.
# US_REFERENCE_DATA_DIR=data/reference_data/us_indices
US_CALENDAR_PATH=data/calendar/us.txt
US_INDEX_PATH=data/instruments/us.txt

# Stripe (leave blank if subscriptions are disabled)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
STRIPE_TRIAL_PERIOD_DAYS=30
