# Database
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=predixlab
MARKET_OVERVIEWS_COLLECTION=market_overviews
ALPHARANK_COLLECTION=alpharank
ALPHARANK_GENERATIONS_COLLECTION=alpharank_generations

# JWT (replace SECRET_KEY before deployment)
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth session signing: required, generate independently of SECRET_KEY
# python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# Email: use console locally; switch to acs and configure ACS for production
# EMAIL_BACKEND: "acs" delivers via Azure Communication Services,
# "console" logs the message instead (use this for local development).
EMAIL_BACKEND=console
ACS_CONNECTION_STRING=
ACS_SENDER=

# OAuth (leave unused providers blank)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_CALLBACK_URL="http://localhost:8000/api/v1/auth/google/callback"

MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_OAUTH_CALLBACK_URL="http://localhost:8000/api/v1/auth/microsoft/callback"

# Frontend URL to return to after OAuth completes
OAUTH_REDIRECT_URL="http://localhost:3000/auth/callback"

# Application
APP_NAME="PredixLab"
APP_VERSION=1.0.0
PUBLIC_API_URL="http://localhost:8000"
USER_NOTICE_VERSION=2026-08-09
DEBUG=False
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
FREE_USER_DAYS_LIMIT=10

# Referral program
REFERRAL_PROGRAM_ENABLED=True
REFERRAL_FRONTEND_URL="http://localhost:3000/register"
REFERRAL_CODE_LENGTH=8
REFERRAL_INVITER_REWARD_DAYS=15
REFERRAL_INVITEE_REWARD_DAYS=7
REFERRAL_MAX_REWARDED_REFERRALS=20

# Shared data paths from Collector
# These two directories remain Settings compatibility fields; the service does not read from them.
PREDICTIONS_DIR=data/predictions
PICKS_DIR=data/picks
PREDIXLAB_DATA_DIR=data
US_STOCK_DATA_DIR=data/stock_data/us_data
US_CALENDAR_PATH=data/calendar/us.txt
US_INDEX_PATH=data/instruments/us.txt

# Stripe (leave blank if subscriptions are disabled)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
STRIPE_TRIAL_PERIOD_DAYS=30
